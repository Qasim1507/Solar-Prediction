# Copy this file to .env and fill in your values.
# Never commit .env to git — it is listed in .gitignore.
#
# These credentials are OPTIONAL. The live satellite fetch uses the NICT
# public Himawari tile server, which needs no login. JAXA P-Tree FTP is only
# used as a fallback if NICT is unreachable.
#
# ── Satellite image sources (comma-separated, tried in order) ────────────────
# nict   — Himawari via NICT public server. DEFAULT and recommended: it is the
#          exact source and preprocessing used for the training images.
#          Bad/black tiles are auto-rejected and older frames retried.
# slider — Himawari via RAMMB/CIRA SLIDER. Different provider, SAME satellite,
#          so it is a safe redundancy option. UNVERIFIED URL pattern.
# gk2a   — GK-2A (Korean satellite, 128.2°E). A DIFFERENT SENSOR: the model was
#          never trained on it, so accuracy will likely drop unless you retrain
#          on GK-2A imagery. UNVERIFIED URL pattern.
# jaxa   — Himawari via JAXA P-Tree FTP (needs the credentials below).
SATELLITE_SOURCES=nict,jaxa

# JAXA P-Tree FTP credentials for Himawari satellite data
# Register at: https://www.eorc.jaxa.jp/ptree/userguide.html
# Username is your email with "@" replaced by "_" (e.g. name_gmail.com)
JAXA_FTP_USER=your_username_here
JAXA_FTP_PASS=your_password_here
