# Copy this file to .env and fill in your values.
# Never commit .env to git — it is listed in .gitignore.
#
# These credentials are OPTIONAL. The live satellite fetch uses the NICT
# public Himawari tile server, which needs no login. JAXA P-Tree FTP is only
# used as a fallback if NICT is unreachable.
#
# JAXA P-Tree FTP credentials for Himawari satellite data
# Register at: https://www.eorc.jaxa.jp/ptree/userguide.html
# Username is your email with "@" replaced by "_" (e.g. name_gmail.com)
JAXA_FTP_USER=your_username_here
JAXA_FTP_PASS=your_password_here
