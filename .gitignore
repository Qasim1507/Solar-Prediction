# Secrets — never commit
.env
.env.*
!.env.example
credentials.json

# Data (large / regenerable)
# The satellite imagery is NOT committed: ~51 GB, and it is re-downloadable
# from NOAA's public AWS archive with himawari_aws.py (see scripts/runpod_setup.sh).
data/*
!data/*.csv
datanow/
swimseg/

# Python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
.pytest_cache/

# Editors
.vscode/
.idea/
# Obsidian per-machine window state
docs/notes/.obsidian/workspace.json

# OS junk
.DS_Store

# Generated artifacts
repomix-output.xml
dead_tiles.txt

# Web app run archive
webapp/runs/
presentation/
brag-output*/
report/