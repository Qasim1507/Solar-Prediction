    "axes[0].set_title(\"NLL Loss\"); axes[0].legend()\n",
    "axes[1].plot(history[\"train_mae\"], label=\"Train\"); axes[1].plot(history[\"val_mae\"], label=\"Val\")\n",
    "axes[1].set_title(\"MAE t+1h (W)\"); axes[1].legend()\n",
