    "lr_leak = LinearRegression().fit(X_tr_l, y_tr_l)\n",
    "print(f\"Leaky LR (random split, ghi only) → R²: {r2_score(y_te_l, lr_leak.predict(X_te_l)):.4f}\")\n",
