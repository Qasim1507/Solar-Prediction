    "import os\n",
    "os.environ[\"PYTORCH_ENABLE_MPS_FALLBACK\"] = \"1\"\n",
    "\n",
    "# =========================\n",
    "# 📥 GOOGLE DRIVE DOWNLOAD (OAuth, retry-safe)\n",
    "# pip install google-auth google-auth-oauthlib google-auth-httplib2 google-api-python-client\n",
    "# =========================\n",
    "\n",
    "from googleapiclient.discovery import build\n",
    "from googleapiclient.http import MediaIoBaseDownload\n",
    "from googleapiclient.errors import HttpError\n",
    "from google_auth_oauthlib.flow import InstalledAppFlow\n",
    "from google.auth.transport.requests import Request\n",
    "from google.oauth2.credentials import Credentials\n",
    "import time\n",
    "import io\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import psutil\n",
    "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.linear_model import LinearRegression\n",
    "from sklearn.ensemble import RandomForestRegressor\n",
    "import lightgbm as lgb\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "import torchvision.models as models\n",
    "import timm\n",
    "from PIL import Image\n",
    "import warnings\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "\n",
    "# =========================\n",
    "# 🔧 CONFIGURATION\n",
    "# =========================\n",
    "FOLDER_ID        = \"1lYPeHBMH16KY5LNSq6gThaCVqrY_3IBd\"\n",
    "OUTPUT_DIR       = \"data\"\n",
    "SCOPES           = [\"https://www.googleapis.com/auth/drive.readonly\"]\n",
    "TOKEN_FILE       = \"token.json\"\n",
    "CREDENTIALS_FILE = \"credentials.json\"\n",
    "\n",
    "MAX_RETRIES      = 7        # max retry attempts per API call\n",
    "BASE_WAIT        = 2        # seconds before first retry (doubles each attempt)\n",
    "\n",
    "\n",
    "# =========================\n",
    "# 🔁 RETRY HELPER\n",
    "# =========================\n",
    "def execute_with_retry(request, max_retries=MAX_RETRIES):\n",
    "    \"\"\"\n",
    "    Executes a Google API request with exponential backoff retry.\n",
    "    Retries on 500 (Internal Error) and 503 (Service Unavailable).\n",
    "    Raises immediately on 4xx errors (auth/permission issues).\n",
    "    \"\"\"\n",
    "    wait = BASE_WAIT\n",
    "    for attempt in range(max_retries):\n",
    "        try:\n",
    "            return request.execute()\n",
    "        except HttpError as e:\n",
    "            if e.resp.status in (500, 503, 429):\n",
    "                print(f\"\\n⚠️  HTTP {e.resp.status} — retrying in {wait}s \"\n",
    "                      f\"(attempt {attempt + 1}/{max_retries})...\")\n",
    "                time.sleep(wait)\n",
    "                wait *= 2  # exponential backoff\n",
    "            else:\n",
    "                raise  # don't retry on 403, 404, etc.\n",
    "    raise RuntimeError(f\"❌ Failed after {max_retries} retries.\")\n",
    "\n",
    "\n",
    "# =========================\n",
    "# 🔐 OAUTH AUTHENTICATION\n",
    "# =========================\n",
    "def get_drive_service():\n",
    "    \"\"\"\n",
    "    Authenticates via OAuth and returns a Google Drive API service object.\n",
    "\n",
    "    First run  : opens a browser window to log in and grant access.\n",
    "    Later runs : reuses token.json silently (auto-refreshes if expired).\n",
    "\n",
    "    To get credentials.json:\n",
    "      1. https://console.cloud.google.com/\n",
    "      2. Enable Google Drive API\n",
    "      3. APIs & Services → Credentials → OAuth 2.0 Client ID → Desktop App\n",
    "      4. Download JSON → save as credentials.json next to this script\n",
    "    \"\"\"\n",
    "    creds = None\n",
    "\n",
    "    if os.path.exists(TOKEN_FILE):\n",
    "        creds = Credentials.from_authorized_user_file(TOKEN_FILE, SCOPES)\n",
    "\n",
    "    if not creds or not creds.valid:\n",
    "        if creds and creds.expired and creds.refresh_token:\n",
    "            creds.refresh(Request())\n",
    "        else:\n",
    "            if not os.path.exists(CREDENTIALS_FILE):\n",
    "                raise FileNotFoundError(\n",
    "                    f\"\\n❌ '{CREDENTIALS_FILE}' not found.\\n\"\n",
    "                    \"Download it from Google Cloud Console:\\n\"\n",
    "                    \"  APIs & Services → Credentials → OAuth 2.0 Client ID\\n\"\n",
    "                    \"  → Desktop App → Download JSON → save as credentials.json\"\n",
    "                )\n",
    "            flow = InstalledAppFlow.from_client_secrets_file(CREDENTIALS_FILE, SCOPES)\n",
    "            creds = flow.run_local_server(port=0)\n",
    "\n",
    "        with open(TOKEN_FILE, \"w\") as token:\n",
    "            token.write(creds.to_json())\n",
    "        print(\"✅ Authenticated! Token saved to token.json for future runs.\")\n",
    "\n",
    "    return build(\"drive\", \"v3\", credentials=creds)\n",
    "\n",
    "\n",
    "# =========================\n",
    "# 📥 RECURSIVE FOLDER DOWNLOAD\n",
    "# =========================\n",
    "def download_all_files(service, folder_id, output_dir):\n",
    "    \"\"\"\n",
    "    Recursively downloads all files from a Google Drive folder.\n",
    "    - Skips files that already exist locally\n",
    "    - Handles subfolders\n",
    "    - Retries on transient Google 500/503 errors\n",
    "    \"\"\"\n",
    "    os.makedirs(output_dir, exist_ok=True)\n",
    "    page_token = None\n",
    "    downloaded = 0\n",
    "    skipped = 0\n",
    "\n",
    "    while True:\n",
    "        request = service.files().list(\n",
    "            q=f\"'{folder_id}' in parents and trashed=false\",\n",
    "            pageSize=100,\n",
    "            fields=\"nextPageToken, files(id, name, mimeType, size)\",\n",
    "            pageToken=page_token\n",
    "        )\n",
    "        results = execute_with_retry(request)\n",
    "\n",
    "        for f in results.get(\"files\", []):\n",
    "            dest_path = os.path.join(output_dir, f[\"name\"])\n",
    "\n",
    "            # Recurse into subfolders\n",
    "            if f[\"mimeType\"] == \"application/vnd.google-apps.folder\":\n",
    "                print(f\"\\n📂 Entering subfolder: {f['name']}/\")\n",
    "                sub_dl, sub_sk = download_all_files(service, f[\"id\"], dest_path)\n",
    "                downloaded += sub_dl\n",
    "                skipped    += sub_sk\n",
    "                continue\n",
    "\n",
    "            # Skip existing files\n",
    "            if os.path.exists(dest_path):\n",
    "                skipped += 1\n",
    "                print(f\"⏭️  Skipping (exists): {f['name']}\")\n",
    "                continue\n",
    "\n",
    "            # Download with per-file retry\n",
    "            size_mb = int(f.get(\"size\", 0)) / 1e6\n",
    "            print(f\"📥 Downloading: {f['name']}  ({size_mb:.1f} MB)\")\n",
    "\n",
    "            for attempt in range(MAX_RETRIES):\n",
    "                try:\n",
    "                    dl_request = service.files().get_media(fileId=f[\"id\"])\n",
    "                    with open(dest_path, \"wb\") as fh:\n",
    "                        downloader = MediaIoBaseDownload(\n",
    "                            fh, dl_request, chunksize=8 * 1024 * 1024\n",
    "                        )\n",
    "                        done = False\n",
    "                        while not done:\n",
    "                            status, done = downloader.next_chunk()\n",
    "                            if status:\n",
    "                                print(f\"   {int(status.progress() * 100):3d}%\", end=\"\\r\")\n",
    "                    print(f\"   ✅ {f['name']}\")\n",
    "                    downloaded += 1\n",
    "                    break  # success — exit retry loop\n",
    "\n",
    "                except HttpError as e:\n",
    "                    if e.resp.status in (500, 503, 429):\n",
    "                        wait = BASE_WAIT * (2 ** attempt)\n",
    "                        print(f\"\\n⚠️  HTTP {e.resp.status} on '{f['name']}' — \"\n",
    "                              f\"retrying in {wait}s (attempt {attempt + 1}/{MAX_RETRIES})...\")\n",
    "                        # Remove partial file before retrying\n",
    "                        if os.path.exists(dest_path):\n",
    "                            os.remove(dest_path)\n",
    "                        time.sleep(wait)\n",
    "                    else:\n",
