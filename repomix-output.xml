    "import torch\n",
    "import time\n",
    "import platform\n",
    "\n",
    "# ============================================================================\n",
    "# DEVICE SETUP - Works on Mac and RunPod\n",
    "# ============================================================================\n",
    "\n",
    "# Check if CUDA is available (RunPod/Linux)\n",
    "if torch.cuda.is_available():\n",
    "    device = torch.device(\"cuda\")\n",
    "    print(f\"✅ Using CUDA GPU: {torch.cuda.get_device_name(0)}\")\n",
    "    print(f\"   VRAM: {torch.cuda.get_device_properties(0).total_memory / 1e9:.1f} GB\")\n",
    "else:\n",
    "    device = torch.device(\"cpu\")\n",
    "    print(f\"⚠️  Using CPU (CUDA not available)\")\n",
    "    \n",
    "    # On Mac, MPS is available but has attention issues, so we stick to CPU\n",
    "    if torch.backends.mps.is_available():\n",
    "        print(\"   Note: MPS available but disabled for stability\")\n",
    "\n",
    "# ============================================================================\n",
    "# DATA LOADERS - Platform-aware (fixes the BrokenPipeError)\n",
    "# ============================================================================\n",
    "\n",
    "# Detect OS\n",
    "is_macos = platform.system() == 'Darwin'\n",
    "is_windows = platform.system() == 'Windows'\n",
    "\n",
    "# Safe settings for each platform\n",
    "if is_macos or is_windows:\n",
    "    NUM_WORKERS = 0\n",
    "    PIN_MEMORY = False\n",
    "    print(\"⚠️  Running on macOS/Windows - using num_workers=0 (multiprocessing safe)\")\n",
    "else:\n",
    "    NUM_WORKERS = 4\n",
    "    PIN_MEMORY = True\n",
    "    print(f\"✅ Running on Linux - using num_workers={NUM_WORKERS} with pin_memory\")\n",
    "\n",
    "# Batch size (adjust based on your GPU memory)\n",
    "# 64 for A5000 (24GB), 32 for smaller GPUs, 16 for CPU\n",
    "if torch.cuda.is_available():\n",
    "    BATCH_SIZE = 64  # A5000 has 24GB VRAM\n",
    "    print(f\"📦 Batch size: {BATCH_SIZE} (optimized for GPU)\")\n",
    "else:\n",
    "    BATCH_SIZE = 16  # CPU can't handle large batches\n",
    "    print(f\"📦 Batch size: {BATCH_SIZE} (CPU mode)\")\n",
    "\n",
    "# Create DataLoaders\n",
    "train_loader = DataLoader(\n",
    "    train_dataset, \n",
    "    batch_size=BATCH_SIZE, \n",
    "    shuffle=True, \n",
    "    num_workers=NUM_WORKERS,\n",
    "    pin_memory=PIN_MEMORY\n",
    ")\n",
    "\n",
    "val_loader = DataLoader(\n",
    "    val_dataset, \n",
    "    batch_size=BATCH_SIZE, \n",
    "    shuffle=False, \n",
    "    num_workers=NUM_WORKERS,\n",
    "    pin_memory=PIN_MEMORY\n",
    ")\n",
    "\n",
    "test_loader = DataLoader(\n",
    "    test_dataset, \n",
    "    batch_size=BATCH_SIZE, \n",
    "    shuffle=False, \n",
    "    num_workers=NUM_WORKERS,\n",
    "    pin_memory=PIN_MEMORY\n",
    ")\n",
    "\n",
    "print(f\"   Train batches: {len(train_loader)}\")\n",
    "print(f\"   Val batches: {len(val_loader)}\")\n",
    "print(f\"   Test batches: {len(test_loader)}\")\n",
    "\n",
    "# ============================================================================\n",
    "# LOSS FUNCTION\n",
    "# ============================================================================\n",
    "\n",
    "def gaussian_nll_loss(mu, sigma, target):\n",
    "    return torch.mean(torch.sum(torch.log(sigma) + (target - mu)**2 / (2 * sigma**2), dim=1))\n",
    "\n",
    "# ============================================================================\n",
    "# DIAGNOSTIC FORWARD PASS\n",
    "# ============================================================================\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"🔍 RUNNING DIAGNOSTIC FORWARD PASS\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# Create model (use ResNet50 for better speed/accuracy balance)\n",
    "model_full = PhysicsGatedFusionModel(ablation=None, image_type=\"resnet\")\n",
    "model_full = model_full.to(device)\n",
    "\n",
    "# CUDA optimizations (only if on GPU)\n",
    "if torch.cuda.is_available():\n",
    "    torch.backends.cudnn.benchmark = True\n",
    "    torch.backends.cuda.matmul.allow_tf32 = True\n",
    "    torch.backends.cudnn.allow_tf32 = True\n",
    "    print(\"✅ CUDA optimizations enabled (TF32, cuDNN benchmark)\")\n",
    "\n",
    "try:\n",
    "    test_batch = next(iter(train_loader))\n",
    "    print(\"✓ Loaded test batch\")\n",
    "    \n",
    "    # Move to device\n",
    "    tab = test_batch[\"tabular_seq\"].to(device, non_blocking=PIN_MEMORY)\n",
    "    img = test_batch[\"image\"].to(device, non_blocking=PIN_MEMORY)\n",
    "    fc = test_batch[\"future_clearsky\"].to(device, non_blocking=PIN_MEMORY)\n",
    "    gf = test_batch[\"gate_features\"].to(device, non_blocking=PIN_MEMORY)\n",
    "    \n",
    "    print(\"  Testing forward pass...\")\n",
    "    with torch.no_grad():\n",
    "        mu, sigma = model_full(tab, img, fc, gf)\n",
    "    \n",
    "    print(f\"  ✓ Forward pass successful!\")\n",
    "    print(f\"    mu shape: {mu.shape}\")\n",
    "    print(f\"    sigma shape: {sigma.shape}\")\n",
    "    \n",
    "    if torch.cuda.is_available():\n",
    "        print(f\"    GPU memory used: {torch.cuda.memory_allocated() / 1e9:.2f} GB\")\n",
    "    \n",
    "    print(\"  ✓ Model is ready for training\")\n",
    "    \n",
    "    # Clean up\n",
    "    del tab, img, fc, gf, mu, sigma, test_batch\n",
    "    if torch.cuda.is_available():\n",
    "        torch.cuda.empty_cache()\n",
    "    \n",
    "except Exception as e:\n",
    "    print(f\"  ✗ Forward pass failed: {e}\")\n",
    "    print(\"\\nTroubleshooting:\")\n",
    "    print(\"  - Check if images loaded correctly\")\n",
    "    print(\"  - Reduce batch size if out of memory\")\n",
    "    print(\"  - Try running on CPU first to isolate issue\")\n",
    "    raise\n",
    "\n",
    "print(f\"\\n🚀 Ready for training on: {device}\\n\")\n",
    "\n",
    "# ============================================================================\n",
    "# TRAINING FUNCTION\n",
    "# ============================================================================\n",
    "\n",
    "def train_model(model, train_loader, val_loader, epochs=30, patience=15, ckpt=\"best_model.pt\"):\n",
    "    optimizer = torch.optim.AdamW(model.parameters(), lr=1e-4, weight_decay=1e-2)\n",
    "    scheduler = torch.optim.lr_scheduler.CosineAnnealingWarmRestarts(optimizer, T_0=10)\n",
    "    \n",
    "    # AMP only for CUDA (not for CPU or MPS)\n",
    "    use_amp = torch.cuda.is_available()\n",
    "    scaler = torch.amp.GradScaler(device_type=\"cuda\") if use_amp else None\n",
    "    \n",
    "    best_val, pat_cnt = float(\"inf\"), 0\n",
    "    history = {k: [] for k in [\"train_nll\", \"val_nll\", \"train_mae\", \"val_mae\"]}\n",
    "    model.to(device)\n",
    "    \n",
    "    n_batches = len(train_loader)\n",
    "    \n",
    "    print(f\"\\n{'Ep':>4} | {'Tr NLL':>8} {'Tr MAE':>8} | {'Va NLL':>8} {'Va MAE':>8} | {'Status':<14} {'Time':>6}\")\n",
    "    print(\"-\" * 75)\n",
    "    \n",
    "    start_total = time.time()\n",
    "    \n",
    "    for epoch in range(epochs):\n",
    "        epoch_start = time.time()\n",
    "        \n",
    "        # Unfreeze CNN after warmup\n",
    "        if epoch == 5 and hasattr(model, 'unfreeze_cnn'):\n",
    "            model.unfreeze_cnn()\n",
    "            # Reduce LR when unfreezing\n",
    "            for param_group in optimizer.param_groups:\n",
    "                param_group['lr'] = 5e-5\n",
    "            print(\"  ★ CNN unfrozen, LR reduced to 5e-5\")\n",
    "        \n",
    "        # ========== TRAINING ==========\n",
    "        model.train()\n",
    "        tr_loss = tr_mae = 0.0\n",
    "        batch_count = 0\n",
    "        \n",
    "        for batch_idx, batch in enumerate(train_loader):\n",
    "            tab = batch[\"tabular_seq\"].to(device)\n",
    "            img = batch[\"image\"].to(device)\n",
    "            fc = batch[\"future_clearsky\"].to(device)\n",
    "            tgt = batch[\"targets\"].to(device)\n",
    "            gf = batch[\"gate_features\"].to(device)\n",
    "            \n",
    "            optimizer.zero_grad(set_to_none=True)\n",
    "            \n",
    "            if use_amp:\n",
    "                with torch.amp.autocast(device_type=\"cuda\"):\n",
    "                    mu, sigma = model(tab, img, fc, gf)\n",
    "                    loss = gaussian_nll_loss(mu, sigma, tgt)\n",
    "                \n",
    "                scaler.scale(loss).backward()\n",
    "                scaler.unscale_(optimizer)\n",
    "                torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n",
    "                scaler.step(optimizer)\n",
    "                scaler.update()\n",
    "            else:\n",
    "                mu, sigma = model(tab, img, fc, gf)\n",
    "                loss = gaussian_nll_loss(mu, sigma, tgt)\n",
    "                loss.backward()\n",
    "                torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n",
    "                optimizer.step()\n",
    "            \n",
    "            tr_loss += loss.item() * tgt.size(0)\n",
    "            tr_mae += torch.abs(mu[:, 0] - tgt[:, 0]).sum().item()\n",
    "            batch_count += 1\n",
    "            \n",
    "            # Progress indicator\n",
    "            if (batch_idx + 1) % 20 == 0 or (batch_idx + 1) == n_batches:\n",
    "                elapsed = time.time() - epoch_start\n",
    "                print(f\"  Ep{epoch+1} batch {batch_idx+1}/{n_batches} | \"\n",
    "                      f\"loss={loss.item():.3f} | {elapsed:.0f}s elapsed\", end=\"\\r\")\n",
    "        \n",
    "        if batch_count == 0:\n",
    "            print(f\"  ⚠️  No batches processed, skipping...\")\n",
    "            continue\n",
    "        \n",
    "        scheduler.step()\n",
    "        \n",
    "        # ========== VALIDATION ==========\n",
    "        model.eval()\n",
    "        va_loss = va_mae = 0.0\n",
    "        val_count = 0\n",
    "        \n",
    "        with torch.no_grad():\n",
    "            for batch in val_loader:\n",
    "                tab = batch[\"tabular_seq\"].to(device)\n",
    "                img = batch[\"image\"].to(device)\n",
    "                fc = batch[\"future_clearsky\"].to(device)\n",
    "                tgt = batch[\"targets\"].to(device)\n",
    "                gf = batch[\"gate_features\"].to(device)\n",
    "                \n",
    "                if use_amp:\n",
    "                    with torch.amp.autocast(device_type=\"cuda\"):\n",
    "                        mu, sigma = model(tab, img, fc, gf)\n",
    "                        loss = gaussian_nll_loss(mu, sigma, tgt)\n",
    "                else:\n",
    "                    mu, sigma = model(tab, img, fc, gf)\n",
    "                    loss = gaussian_nll_loss(mu, sigma, tgt)\n",
    "                \n",
    "                va_loss += loss.item() * tgt.size(0)\n",
    "                va_mae += torch.abs(mu[:, 0] - tgt[:, 0]).sum().item()\n",
    "                val_count += 1\n",
    "        \n",
    "        # Normalize\n",
    "        ntr = len(train_loader.dataset)\n",
    "        nva = len(val_loader.dataset)\n",
    "        tr_loss /= ntr\n",
    "        va_loss /= nva\n",
    "        tr_mae /= ntr\n",
    "        va_mae /= nva\n",
    "        \n",
    "        history[\"train_nll\"].append(tr_loss)\n",
    "        history[\"val_nll\"].append(va_loss)\n",
    "        history[\"train_mae\"].append(tr_mae)\n",
    "        history[\"val_mae\"].append(va_mae)\n",
    "        \n",
    "        # Save best model\n",
    "        ep_time = time.time() - epoch_start\n",
    "        remaining = ep_time * (epochs - epoch - 1)\n",
    "        \n",
    "        if va_loss < best_val:\n",
    "            best_val, pat_cnt = va_loss, 0\n",
    "            torch.save(model.state_dict(), ckpt)\n",
    "            status = \"✓ saved\"\n",
    "        else:\n",
    "            pat_cnt += 1\n",
    "            status = f\"patience {pat_cnt}/{patience}\"\n",
    "        \n",
    "        print(f\"{epoch+1:>4} | {tr_loss:>8.3f} {tr_mae:>7.1f}W | \"\n",
    "              f\"{va_loss:>8.3f} {va_mae:>7.1f}W | {status:<14} \"\n",
    "              f\"{ep_time:>5.0f}s  (~{remaining/60:.0f}m left)\")\n",
    "        \n",
    "        if pat_cnt >= patience:\n",
    "            print(f\"  Early stop at epoch {epoch+1}\")\n",
    "            break\n",
    "    \n",
    "    total = time.time() - start_total\n",
    "    print(f\"\\n✅ Done. Best val NLL: {best_val:.4f} → {ckpt} (total: {total/60:.1f}min)\")\n",
    "    return history\n",
    "\n",
    "\n",
    "# ============================================================================\n",
    "# START TRAINING\n",
    "# ============================================================================\n",
    "\n",
    "print(\"=\"*60)\n",
    "print(\"🏋️  STARTING TRAINING\")\n",
    "print(\"=\"*60)\n",
    "print(f\"   Epochs: 30\")\n",
    "print(f\"   Patience: 15\")\n",
    "print(f\"   Batch size: {BATCH_SIZE}\")\n",
    "print(f\"   Device: {device}\")\n",
    "print(f\"   Num workers: {NUM_WORKERS}\")\n",
    "print(\"=\"*60 + \"\\n\")\n",
    "\n",
    "try:\n",
    "    history = train_model(\n",
    "        model_full, \n",
    "        train_loader, \n",
    "        val_loader,\n",
    "        epochs=30, \n",
    "        patience=15, \n",
    "        ckpt=\"best_model.pt\"\n",
    "    )\n",
    "except KeyboardInterrupt:\n",
    "    print(\"\\n⚠️  Training interrupted by user\")\n",
    "    history = None\n",
    "except Exception as e:\n",
    "    print(f\"\\n✗ Training failed: {e}\")\n",
    "    import traceback\n",
    "    traceback.print_exc()\n",
    "    history = None\n",
    "\n",
    "# ============================================================================\n",
    "# PLOT RESULTS\n",
    "# ============================================================================\n",
    "\n",
    "if history and len(history[\"train_nll\"]) > 0:\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "    \n",
    "    axes[0].plot(history[\"train_nll\"], label=\"Train\", linewidth=2)\n",
    "    axes[0].plot(history[\"val_nll\"], label=\"Validation\", linewidth=2)\n",
    "    axes[0].set_title(\"Negative Log-Likelihood Loss\", fontsize=12)\n",
    "    axes[0].set_xlabel(\"Epoch\")\n",
    "    axes[0].set_ylabel(\"NLL Loss\")\n",
    "    axes[0].legend()\n",
    "    axes[0].grid(True, alpha=0.3)\n",
    "    \n",
    "    axes[1].plot(history[\"train_mae\"], label=\"Train\", linewidth=2)\n",
    "    axes[1].plot(history[\"val_mae\"], label=\"Validation\", linewidth=2)\n",
    "    axes[1].set_title(\"MAE (t+1h) - Mean Absolute Error\", fontsize=12)\n",
    "    axes[1].set_xlabel(\"Epoch\")\n",
    "    axes[1].set_ylabel(\"MAE (Watts)\")\n",
    "    axes[1].legend()\n",
    "    axes[1].grid(True, alpha=0.3)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.savefig(\"results/plots/training_curves.png\", dpi=150, bbox_inches=\"tight\")\n",
    "    plt.show()\n",
    "    print(\"\\n📊 Training curves saved to results/plots/training_curves.png\")\n",
    "else:\n",
    "    print(\"\\n⚠️  Training did not complete successfully, skipping plots\")"
   ]
