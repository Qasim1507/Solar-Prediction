   "execution_count": 5,
   "id": "ee25fa11",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Train : 5,322 | Val : 1,120 | Test : 1,120\n",
      "tabular_seq     : torch.Size([24, 10])\n",
      "image           : torch.Size([3, 224, 224])\n",
